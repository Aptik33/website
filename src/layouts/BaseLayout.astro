---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Efektler from '../components/Efektler.astro';
import { SITE } from '../consts.mjs';

interface Props {
  baslik: string;
  aciklama: string;
  tur?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  noIndex?: boolean;
  /** /og/<bolum>/<slug>.png — build sırasında üretilen sayfaya özel görsel. */
  ogYol?: string;
}

const { baslik, aciklama, tur = 'website', jsonLd, noIndex = false, ogYol } = Astro.props;

// build.format: 'file' kullandığımız için Astro.url.pathname sonuna .html
// ekleyebiliyor. Kanonik URL her zaman uzantısız ve sondaki eğik çizgisiz olmalı.
const temizYol = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '');
const canonical = new URL(temizYol, Astro.site).href.replace(/(.)\/$/, '$1');

const tamBaslik = baslik === SITE.title ? baslik : `${baslik} — ${SITE.name}`;

// Sayfaya özel PNG varsa onu, yoksa sitenin varsayılan kapağını kullan.
// SVG'yi og:image olarak vermiyoruz — çoğu sosyal platform SVG render etmiyor.
const ogGorsel = new URL(ogYol ?? '/og/varsayilan.png', Astro.site).href;

/**
 * Google Search Console doğrulama kodu.
 *
 * "HTML etiketi" yöntemini seçersen Google sana `content="..."` içinde bir kod
 * verir. Sadece o kodu buraya koy (veya Cloudflare'de ortam değişkeni olarak
 * tanımla), etiket kendiliğinden basılır.
 *
 * DNS veya Cloudflare entegrasyonuyla doğrularsan buna gerek kalmaz.
 */
const googleDogrulama = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION as string | undefined;

---

<!doctype html>
<html lang="tr" data-theme="dark" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tamBaslik}</title>
    <meta name="description" content={aciklama} />
    <link rel="canonical" href={canonical} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    {/* Open Graph */}
    <meta property="og:type" content={tur} />
    <meta property="og:title" content={tamBaslik} />
    <meta property="og:description" content={aciklama} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogGorsel} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={baslik} />

    {/* Twitter/X — og: etiketlerine fallback yapar ama bazı crawler'lar bunları arar. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tamBaslik} />
    <meta name="twitter:description" content={aciklama} />
    <meta name="twitter:image" content={ogGorsel} />

    {/* Favicon — SVG modern tarayıcılar, PNG eski tarayıcı ve RSS okuyucular için. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {googleDogrulama && <meta name="google-site-verification" content={googleDogrulama} />}

    {/*
      Cloudflare Web Analytics beacon'ı BURAYA EKLENMİYOR — Cloudflare onu
      uç sunucuda, yalnızca gerçek tarayıcı isteklerine enjekte ediyor.
      Elle eklersek çift sayım olur. (curl ile bakınca görünmemesi normal.)
    */}
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <meta name="theme-color" content="#08090c" />
    <meta name="generator" content={Astro.generator} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    {/* Tema, boyanmadan önce ayarlanır — FOUC olmaz. */}
    <script is:inline>
      (() => {
        const kok = document.documentElement;
        kok.classList.remove('no-js');
        const kayitli = localStorage.getItem('tema');
        const sistem = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        kok.dataset.theme = kayitli || sistem;

        /**
         * GÜVENLİK AĞI — Motion ~74 KB'lık bir modül. Yavaş bağlantıda geç
         * gelirse veya hiç gelmezse [data-reveal] elemanları opacity:0'da
         * takılı kalır ve sayfa boş görünür. 2,5 saniye içinde Motion
         * "hazırım" demezse içeriği koşulsuz açıyoruz.
         *
         * Animasyonu kaybetmek kabul edilebilir; içeriği kaybetmek değil.
         */
        setTimeout(() => {
          if (!kok.classList.contains('motion-hazir')) kok.classList.add('hareket-yok');
        }, 2500);
      })();
    </script>
  </head>

  <body class="min-h-screen flex flex-col">
    <a
      href="#icerik"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-3 focus:left-3 focus:px-3 focus:py-2 focus:rounded focus:bg-[var(--surface)] focus:border focus:border-[var(--border)]"
    >
      İçeriğe geç
    </a>

    <Efektler />
    <Header />

    <main id="icerik" class="flex-1 w-full">
      <slot />
    </main>

    <Footer />
  </body>
</html>
