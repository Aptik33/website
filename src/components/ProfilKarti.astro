---
import { SITE, SOSYAL } from '../consts.mjs';
import SosyalIkon from './SosyalIkon.astro';

interface Props {
  /** 'genis' anasayfa için yatay, 'dar' kenar sütunu için dikey. */
  duzen?: 'genis' | 'dar';
}
const { duzen = 'genis' } = Astro.props;
const genis = duzen === 'genis';
---

<article
  class:list={[
    'kutu kart-spot kenar-isin relative overflow-hidden',
    genis ? 'p-6 sm:p-8' : 'p-5',
  ]}
  data-reveal
>
  {/* Üstte ince renk şeridi — kartın "kimlik" olduğunu belli eder. */}
  <div
    class="absolute inset-x-0 top-0 h-px"
    style="background: linear-gradient(90deg, transparent, var(--accent), var(--accent-2), transparent);"
    aria-hidden="true"
  >
  </div>

  <div class:list={['flex gap-5', genis ? 'flex-col sm:flex-row sm:items-start' : 'flex-col']}>
    {/* Avatar */}
    <div class="relative shrink-0" style="width: 88px; height: 88px;">
      <div
        class="absolute -inset-1 rounded-full opacity-60"
        style="background: conic-gradient(from 140deg, var(--accent), var(--accent-2), var(--accent)); filter: blur(8px);"
        aria-hidden="true"
      >
      </div>
      <img
        src={SITE.avatar}
        alt={`${SITE.tamAd} portresi`}
        width="88"
        height="88"
        loading="lazy"
        decoding="async"
        class="relative w-[88px] h-[88px] rounded-full object-cover"
        style="border: 2px solid var(--border-parlak);"
      />
      {/* Durum noktası */}
      <span
        class="absolute bottom-0.5 right-0.5 grid place-items-center w-6 h-6 rounded-full"
        style="background: var(--surface); border: 1px solid var(--border);"
        title="Şu an üretiyor"
      >
        <span class="w-2 h-2 rounded-full" style="background: var(--kat-muhasebe); box-shadow: 0 0 8px var(--kat-muhasebe);"></span>
        <span class="sr-only">Aktif olarak üretiyor</span>
      </span>
    </div>

    {/* Bilgi */}
    <div class="min-w-0 flex-1">
      <h3 class:list={[genis ? 'text-2xl' : 'text-lg']}>{SITE.tamAd}</h3>

      <p class="mt-1.5 font-[var(--font-mono)] text-xs" style="color: var(--accent);">
        {SITE.unvan}
      </p>

      <p class="mt-3 flex items-center gap-1.5 text-xs" style="color: var(--text-soluk);">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        {SITE.konum}
      </p>

      {
        genis && (
          <p class="mt-4 text-sm max-w-md" style="color: var(--text-muted);">
            Python ve yerel yapay zekâ modelleriyle iş süreçlerini otomatikleştiren araçlar
            yazıyorum. Problemleri şantiye ve muhasebe tarafından tanıyorum; çözümü yazılımla kuruyorum.
          </p>
        )
      }

      {/* Sosyal bağlantılar */}
      <ul class="mt-5 flex flex-wrap gap-2">
        {
          SOSYAL.map((s) => (
            <li>
              <a
                href={s.href}
                target={s.href.startsWith('mailto:') ? undefined : '_blank'}
                rel="me noopener noreferrer"
                class="group flex items-center gap-2 px-3 py-2 rounded-[var(--radius-buton)] border transition-colors hover:border-[var(--border-parlak)] hover:bg-[var(--surface-2)]"
                style="color: var(--text-muted);"
                aria-label={`${s.ad}: ${s.kullanici}`}
              >
                <span class="transition-colors group-hover:text-[var(--accent)]">
                  <SosyalIkon ad={s.ad} boyut={16} />
                </span>
                <span class="font-[var(--font-mono)] text-xs">{s.ad}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</article>
