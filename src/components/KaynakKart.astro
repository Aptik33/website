---
import type { CollectionEntry } from 'astro:content';
import KategoriRozet from './KategoriRozet.astro';
import { boyutFormat } from '../lib/utils';

interface Props {
  kaynak: CollectionEntry<'kaynaklar'>;
}

const { kaynak } = Astro.props;
const d = kaynak.data;
---

<article
  class="kutu kart-spot kat-serit p-6 flex flex-col h-full"
  style={`--kat: var(--kat-${d.kategori});`}
  data-reveal
>
  <div class="flex items-center gap-2 flex-wrap mb-4">
    <KategoriRozet kategori={d.kategori} />
    <span class="etiket">v{d.surum}</span>
    <span class="etiket">{d.lisans}</span>
  </div>

  <h3 class="text-lg leading-snug">
    <a
      href={`/kaynaklar/${kaynak.id}`}
      class="transition-colors hover:text-[var(--accent)] after:absolute after:inset-0"
    >
      {d.baslik}
      <span class="sr-only"> — kaynak sayfasını aç</span>
    </a>
  </h3>

  <p class="mt-2.5 text-sm flex-1" style="color: var(--text-muted);">{d.aciklama}</p>

  <div
    class="mt-5 pt-4 border-t flex items-center justify-between gap-3 font-[var(--font-mono)] text-xs"
    style="border-color: var(--border);"
  >
    <span class="truncate flex items-center gap-2" style="color: var(--text-muted);">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" aria-hidden="true" class="shrink-0">
        <path d="M12 3v12m0 0 4-4m-4 4-4-4M4 19h16"></path>
      </svg>
      {d.dosyaAdi}
    </span>
    <span class="shrink-0" style="color: var(--accent);">{boyutFormat(d.dosyaBoyutu)}</span>
  </div>
</article>
