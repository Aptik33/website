---
import { NAV, SITE } from '../consts.mjs';
import ThemeToggle from './ThemeToggle.astro';
import Arama from './Arama.astro';

const yol = Astro.url.pathname.replace(/\.html$/, '');
const aktif = (href: string) => yol === href || yol.startsWith(href + '/');
---

<header
  id="ust-bar"
  class="sticky top-0 z-40 border-b transition-[background-color,border-color,backdrop-filter] duration-300"
  style="background: color-mix(in srgb, var(--bg) 72%, transparent); border-color: transparent; backdrop-filter: blur(14px) saturate(160%);"
>
  <div class="mx-auto max-w-6xl px-5 h-16 flex items-center gap-4">
    <a href="/" class="shrink-0 group flex items-center gap-2.5">
      <span
        class="grid place-items-center w-7 h-7 rounded-md font-[var(--font-mono)] text-sm font-bold transition-transform group-hover:scale-105"
        style="background: var(--accent); color: var(--accent-contrast);"
        aria-hidden="true">A</span
      >
      <span class="font-[var(--font-baslik)] font-bold text-lg tracking-tight">{SITE.name}</span>
    </a>

    <nav class="hidden lg:flex items-center gap-0.5 ml-3" aria-label="Ana menü">
      {
        NAV.map((n) => (
          <a
            href={n.href}
            class="relative px-3 py-1.5 rounded-[var(--radius-buton)] text-sm transition-colors hover:text-[var(--text)]"
            style={aktif(n.href) ? 'color: var(--text);' : 'color: var(--text-muted);'}
            aria-current={aktif(n.href) ? 'page' : undefined}
          >
            {n.ad}
            {aktif(n.href) && (
              <span
                class="absolute left-3 right-3 -bottom-px h-px"
                style="background: linear-gradient(90deg, transparent, var(--accent), transparent);"
                aria-hidden="true"
              />
            )}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <Arama />
      <ThemeToggle />
      <button
        type="button"
        id="menu-ac"
        class="lg:hidden p-2 rounded-[var(--radius-buton)] border transition-colors hover:bg-[var(--surface-2)]"
        aria-label="Menüyü aç"
        aria-expanded="false"
        aria-controls="mobil-menu"
      >
        <svg class="ikon-menu" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
        <svg class="ikon-kapat" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobil-menu"
    hidden
    class="lg:hidden border-t px-5 py-3 flex flex-col gap-1"
    style="border-color: var(--border); background: var(--bg-yukselti);"
    aria-label="Mobil menü"
  >
    {
      NAV.map((n) => (
        <a
          href={n.href}
          class="px-3 py-2 rounded-[var(--radius-buton)] text-sm"
          style={aktif(n.href) ? 'color: var(--accent); background: var(--accent-soft);' : ''}
          aria-current={aktif(n.href) ? 'page' : undefined}
        >
          {n.ad}
        </a>
      ))
    }
  </nav>
</header>

<style>
  /* İkon durumu aria-expanded'den türetilir; JS'te ayrıca yönetilmez. */
  #menu-ac[aria-expanded='true'] .ikon-menu,
  #menu-ac[aria-expanded='false'] .ikon-kapat {
    display: none;
  }
</style>

<script>
  const btn = document.getElementById('menu-ac');
  const menu = document.getElementById('mobil-menu');
  const bar = document.getElementById('ust-bar');
  function menuAyarla(acik: boolean) {
    if (!btn || !menu) return;
    btn.setAttribute('aria-expanded', String(acik));
    btn.setAttribute('aria-label', acik ? 'Menüyü kapat' : 'Menüyü aç');
    menu.hidden = !acik;
    // İkon değişimi CSS'te aria-expanded'e bağlı; tek doğruluk kaynağı o.
  }

  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    menuAyarla(menu?.hidden ?? true);
  });

  // Dışarı tıklayınca kapansın.
  document.addEventListener('click', (e) => {
    if (!menu || menu.hidden) return;
    if (!menu.contains(e.target as Node)) menuAyarla(false);
  });

  // Escape ile kapansın, odak butona dönsün.
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) {
      menuAyarla(false);
      btn?.focus();
    }
  });

  // Sayfa kaydırılınca üst bar kenarlık ve zemin kazansın.
  const barGuncelle = () => {
    if (!bar) return;
    const kaydi = window.scrollY > 8;
    bar.style.borderColor = kaydi ? 'var(--border)' : 'transparent';
    bar.style.background = `color-mix(in srgb, var(--bg) ${kaydi ? 88 : 72}%, transparent)`;
  };
  barGuncelle();
  window.addEventListener('scroll', barGuncelle, { passive: true });
</script>
