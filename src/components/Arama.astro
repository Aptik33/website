---
/**
 * Site içi arama (Pagefind).
 *
 * React ile yazılmadı: React runtime'ı her sayfaya ~186 KB ekliyordu,
 * bu modal saf DOM ile ~2 KB'ta çözülüyor.
 *
 * Pagefind istemcisi yalnızca `npm run build` sonrası oluşur; dev
 * ortamında kullanıcıya bunu söyleyen bir mesaj gösterilir.
 */
---

<button
  type="button"
  id="arama-ac"
  class="group flex items-center gap-2 h-9 pl-2.5 pr-2 rounded-[var(--radius-buton)] border transition-colors hover:bg-[var(--surface-2)] hover:border-[var(--border-parlak)]"
  aria-label="Sitede ara"
  aria-haspopup="dialog"
>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="11" cy="11" r="7"></circle>
    <path d="m20 20-3.5-3.5"></path>
  </svg>
  <kbd class="hidden sm:block font-[var(--font-mono)] text-[0.625rem] px-1.5 py-0.5 rounded border" style="color: var(--text-soluk); border-color: var(--border);">
    Ctrl K
  </kbd>
</button>

<div
  id="arama-katman"
  hidden
  class="fixed inset-0 z-50 flex items-start justify-center pt-[12vh] px-4"
  style="background: rgb(0 0 0 / 0.6); backdrop-filter: blur(4px);"
  role="dialog"
  aria-modal="true"
  aria-label="Site içi arama"
>
  <div id="arama-kutu" class="kutu w-full max-w-xl overflow-hidden" style="background: var(--bg-yukselti);">
    <div class="flex items-center gap-3 px-4 py-3 border-b" style="border-color: var(--border);">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <input
        id="arama-girdi"
        type="search"
        placeholder="Yazılarda, projelerde ve kaynaklarda ara…"
        class="flex-1 bg-transparent outline-none text-base"
        autocomplete="off"
      />
      <button type="button" id="arama-kapat" class="etiket cursor-pointer" aria-label="Aramayı kapat">ESC</button>
    </div>

    <div id="arama-sonuc" class="max-h-[55vh] overflow-y-auto"></div>
  </div>
</div>

<script>
  const ac = document.getElementById('arama-ac');
  const kapatBtn = document.getElementById('arama-kapat');
  const katman = document.getElementById('arama-katman');
  const kutu = document.getElementById('arama-kutu');
  const girdi = document.getElementById('arama-girdi') as HTMLInputElement | null;
  const sonucAlan = document.getElementById('arama-sonuc');

  // Pagefind kendi tip tanımını yayınlamıyor ve dosya build sonrası
  // oluşuyor; bu yüzden istemci burada bilinçli olarak `any`.
  let pagefind: any = null;
  let durum: 'bos' | 'hazir' | 'yok' = 'bos';
  let zamanlayici: number | undefined;
  let oncekiOdak: HTMLElement | null = null;

  /** Pagefind meta verisi HTML kaçışlı gelmiyor; DOM'a yazmadan önce escape et. */
  const esc = (s: string) => {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  };

  const mesaj = (metin: string) => {
    if (sonucAlan) {
      sonucAlan.innerHTML =
        '<p class="px-4 py-6 text-sm" style="color: var(--text-muted);">' + metin + '</p>';
    }
  };

  async function yukle() {
    if (pagefind || durum === 'yok') return;
    try {
      const yol = '/pagefind/pagefind.js';
      pagefind = await import(/* @vite-ignore */ yol);
      await pagefind.init();
      durum = 'hazir';
    } catch {
      durum = 'yok';
      mesaj(
        'Arama indeksi yalnızca üretim build&rsquo;inde oluşur. <code>npm run build</code> sonrası <code>npm run preview</code> ile deneyebilirsin.'
      );
    }
  }

  function ara() {
    window.clearTimeout(zamanlayici);
    zamanlayici = window.setTimeout(async () => {
      const q = girdi?.value.trim() ?? '';
      if (!q || durum !== 'hazir' || !sonucAlan) {
        if (!q && sonucAlan && durum === 'hazir') sonucAlan.innerHTML = '';
        return;
      }

      const arama = await pagefind.search(q);
      const ilk = await Promise.all(arama.results.slice(0, 8).map((r: any) => r.data()));

      if (ilk.length === 0) {
        mesaj('Sonuç yok.');
        return;
      }

      // Pagefind dosya adını indeksliyor (build.format: 'file' → *.html).
      // Kanonik URL'ler uzantısız olduğu için uzantıyı burada kırpıyoruz.
      const temizle = (u: string) => u.replace(/\.html$/, '').replace(/\/index$/, '/');

      sonucAlan.innerHTML = ilk
        .map(
          (s: any) =>
            '<a href="' +
            esc(temizle(s.url)) +
            '" class="block px-4 py-3 border-b last:border-b-0 hover:bg-[var(--surface-2)]" style="border-color: var(--border);">' +
            '<div class="font-medium text-sm">' +
            esc(s.meta?.title ?? s.url) +
            '</div>' +
            // excerpt Pagefind'ın kendi <mark> vurgusunu taşır; escape edilmez.
            '<div class="text-xs mt-1" style="color: var(--text-muted);">' +
            s.excerpt +
            '</div></a>'
        )
        .join('');
    }, 160);
  }

  function acKapa(gorunur: boolean) {
    if (!katman) return;
    katman.hidden = !gorunur;
    document.body.style.overflow = gorunur ? 'hidden' : '';

    if (gorunur) {
      oncekiOdak = document.activeElement as HTMLElement;
      yukle();
      girdi?.focus();
    } else {
      oncekiOdak?.focus();
      oncekiOdak = null;
    }
  }

  ac?.addEventListener('click', () => acKapa(true));
  kapatBtn?.addEventListener('click', () => acKapa(false));
  katman?.addEventListener('click', () => acKapa(false));
  kutu?.addEventListener('click', (e) => e.stopPropagation());
  girdi?.addEventListener('input', ara);

  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      acKapa(katman?.hidden ?? true);
      return;
    }
    if (e.key === 'Escape' && katman && !katman.hidden) acKapa(false);
  });

  /**
   * Focus trap: modal açıkken Tab, odağı modalın dışına çıkarmamalı.
   * Sonuç listesi dinamik olduğu için odaklanabilirler her Tab'da
   * yeniden hesaplanır.
   */
  kutu?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || !kutu) return;

    const odaklanabilir = Array.from(
      kutu.querySelectorAll<HTMLElement>('input, a[href], button, [tabindex]:not([tabindex="-1"])')
    ).filter((el) => el.offsetParent !== null);

    if (odaklanabilir.length === 0) return;
    const ilk = odaklanabilir[0];
    const son = odaklanabilir[odaklanabilir.length - 1];

    if (e.shiftKey && document.activeElement === ilk) {
      e.preventDefault();
      son.focus();
    } else if (!e.shiftKey && document.activeElement === son) {
      e.preventDefault();
      ilk.focus();
    }
  });
</script>
