# İletişim formu — https://web3forms.com adresinden ücretsiz alınır.
# Bu dosyayı .env olarak kopyalayıp değeri doldur.
PUBLIC_WEB3FORMS_KEY=

# Google Search Console — "HTML etiketi" yöntemiyle doğrularsan
# Google'ın verdiği content="..." değerini buraya yaz.
# DNS ile doğrularsan gerekmez.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Cloudflare Web Analytics — otomatik enjeksiyon çalışmazsa
# Cloudflare → Web Analytics → Manage site → JS snippet içindeki token.
PUBLIC_CF_ANALYTICS_TOKEN=
